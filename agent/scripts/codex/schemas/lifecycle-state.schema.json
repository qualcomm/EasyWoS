{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easywos.local/schemas/lifecycle-state.schema.json",
  "title": "EasyWoS lifecycle state",
  "type": "object",
  "required": ["schema_version", "change_id", "project_root", "phase", "run_status", "evidence", "history"],
  "properties": {
    "schema_version": { "const": 1 },
    "change_id": { "type": "string", "minLength": 1 },
    "project_root": { "type": "string", "minLength": 1 },
    "target": { "type": "string" },
    "phase": {
      "enum": ["PREFLIGHT", "SCAN", "MATCH", "REFINE", "DISPATCH", "INTEGRATE", "BUILD", "TEST", "NEGATIVE_CONTROL", "PROFILE", "VERIFY", "ARCHIVE_READY", "ARCHIVED"]
    },
    "run_status": { "enum": ["ACTIVE", "PAUSED", "STALLED", "FAILED", "COMPLETE"] },
    "evidence": { "type": "object" },
    "history": { "type": "array" }
  },
  "additionalProperties": true
}
